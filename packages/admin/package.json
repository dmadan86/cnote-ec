{
  "name": "@cnote/admin",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "grant": "tsx --env-file=../../.env.local src/cli.ts grant",
    "staff:list": "tsx --env-file=../../.env.local src/cli.ts list",
    "staff:revoke": "tsx --env-file=../../.env.local src/cli.ts revoke"
  },
  "dependencies": {
    "@cnote/core": "workspace:*",
    "@cnote/db": "workspace:*",
    "@cnote/identity": "workspace:*",
    "zod": "^4.1.0"
  }
}
