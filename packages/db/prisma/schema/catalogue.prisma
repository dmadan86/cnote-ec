// Owned by @cnote/catalogue (Catalogue + Moderation). ADR-003, ADR-004, ADR-007.

enum ModerationStatus {
  pending
  approved
  review
  rejected

  @@map("moderation_status")
}

enum ListingStatus {
  draft
  published
  archived

  @@map("listing_status")
}

model Category {
  id              String  @id @default(uuid()) @db.Uuid
  slug            String  @unique
  name            String
  parentId        String? @map("parent_id") @db.Uuid
  /// Max sellers a lead is offered to (ADR-002, default 3)
  leadCap         Int     @default(3) @map("lead_cap")
  /// Prohibited categories cannot hold listings (ADR-003)
  prohibited      Boolean @default(false)
  /// { fields: [{ key, label, type, required, unit? }] }
  attributeSchema Json    @default("{\"fields\":[]}") @map("attribute_schema")
  icon            String? // lucide icon name
  sortOrder       Int     @default(0) @map("sort_order")

  parent    Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryTree")
  listings  Listing[]
  enquiries Enquiry[]

  @@map("categories")
}

model Listing {
  id               String           @id @default(uuid()) @db.Uuid
  sellerBusinessId String           @map("seller_business_id") @db.Uuid
  categoryId       String           @map("category_id") @db.Uuid
  title            String
  description      String           @default("")
  attributes       Json             @default("{}")
  pricePaise       BigInt?          @map("price_paise")
  priceUnit        String?          @map("price_unit") // "piece", "kg", "meter", "set"
  moq              Int?
  moqUnit          String?          @map("moq_unit")
  hsn              String?
  language         String           @default("en")
  imageUrls        String[]         @default([]) @map("image_urls")
  aiGenerated      Boolean          @default(false) @map("ai_generated")
  status           ListingStatus    @default(draft)
  moderationStatus ModerationStatus @default(pending) @map("moderation_status")
  moderationReason String?          @map("moderation_reason")
  /// pgvector; read/write via $queryRaw. HNSW index added in raw SQL migration.
  embedding        Unsupported("vector(256)")?
  embeddingVersion String?          @map("embedding_version")
  /// GENERATED ALWAYS AS to_tsvector('simple', title || ' ' || description) STORED — set in raw SQL migration.
  searchTsv        Unsupported("tsvector")? @map("search_tsv")
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  seller   Business       @relation(fields: [sellerBusinessId], references: [id])
  category Category       @relation(fields: [categoryId], references: [id])
  images   ListingImage[]

  @@index([sellerBusinessId])
  @@index([categoryId, status])
  @@index([searchTsv], map: "listings_search_tsv_idx", type: Gin)
  @@map("listings")
}

/// Seller-uploaded product image. Never public until a staff member with "images.moderate"
/// approves it; the seller sees their own pending/rejected images (with the note). Binary lives in
/// object storage via @cnote/media (storageKey), never in Postgres.
model ListingImage {
  id               String    @id @default(uuid()) @db.Uuid
  listingId        String    @map("listing_id") @db.Uuid
  sellerBusinessId String    @map("seller_business_id") @db.Uuid
  storageKey       String    @unique @map("storage_key")
  mimeType         String    @map("mime_type") // image/jpeg | image/png | image/webp
  bytes            Int
  width            Int?
  height           Int?
  /// sha256 of the bytes: dedupe per listing and block re-upload of rejected images
  sha256           String
  sortOrder        Int       @default(0) @map("sort_order")
  altText          String?   @map("alt_text")
  /// Resized derivatives generated on approval: [{ width, height, format: "avif"|"webp"|"jpeg", key, bytes }]
  variants         Json      @default("[]")
  /// tiny blurred placeholder (data URL, < 1 KB) shown while the real image loads
  blurDataUrl      String?   @map("blur_data_url")
  /// null = not processed yet; derivatives are (re)built by the catalogue worker
  processedAt      DateTime? @map("processed_at") @db.Timestamptz
  status           UgcStatus @default(pending)
  moderationNote   String?   @map("moderation_note") // shown to the seller on rejection
  aiVerdict        String?   @map("ai_verdict") // pre-screen only; never auto-approves
  moderatedBy      String?   @map("moderated_by") @db.Uuid // StaffMember id
  moderatedAt      DateTime? @map("moderated_at") @db.Timestamptz
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz

  listing Listing @relation(fields: [listingId], references: [id])

  @@index([listingId, status, sortOrder])
  @@index([status, createdAt])
  @@index([listingId, sha256])
  @@map("listing_images")
}
