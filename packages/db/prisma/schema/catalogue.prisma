// Owned by @cnote/catalogue (Catalogue + Moderation). ADR-003, ADR-004, ADR-007.

enum ModerationStatus {
  pending
  approved
  review
  rejected

  @@map("moderation_status")
}

enum ListingStatus {
  draft
  published
  archived

  @@map("listing_status")
}

model Category {
  id              String  @id @default(uuid()) @db.Uuid
  slug            String  @unique
  name            String
  parentId        String? @map("parent_id") @db.Uuid
  /// Max sellers a lead is offered to (ADR-002, default 3)
  leadCap         Int     @default(3) @map("lead_cap")
  /// Prohibited categories cannot hold listings (ADR-003)
  prohibited      Boolean @default(false)
  /// { fields: [{ key, label, type, required, unit? }] }
  attributeSchema Json    @default("{\"fields\":[]}") @map("attribute_schema")
  icon            String? // lucide icon name
  sortOrder       Int     @default(0) @map("sort_order")

  parent    Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryTree")
  listings  Listing[]
  enquiries Enquiry[]

  @@map("categories")
}

model Listing {
  id               String           @id @default(uuid()) @db.Uuid
  sellerBusinessId String           @map("seller_business_id") @db.Uuid
  categoryId       String           @map("category_id") @db.Uuid
  title            String
  description      String           @default("")
  attributes       Json             @default("{}")
  pricePaise       BigInt?          @map("price_paise")
  priceUnit        String?          @map("price_unit") // "piece", "kg", "meter", "set"
  moq              Int?
  moqUnit          String?          @map("moq_unit")
  hsn              String?
  /// seller's own product code; the stable key for bulk upsert (unique per seller)
  sku              String?
  language         String           @default("en")
  imageUrls        String[]         @default([]) @map("image_urls")
  aiGenerated      Boolean          @default(false) @map("ai_generated")
  status           ListingStatus    @default(draft)
  moderationStatus ModerationStatus @default(pending) @map("moderation_status")
  moderationReason String?          @map("moderation_reason")
  /// pgvector; read/write via $queryRaw. HNSW index added in raw SQL migration.
  embedding        Unsupported("vector(256)")?
  embeddingVersion String?          @map("embedding_version")
  /// GENERATED ALWAYS AS to_tsvector('simple', title || ' ' || description) STORED — set in raw SQL migration.
  searchTsv        Unsupported("tsvector")? @map("search_tsv")
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  /// version currently projected to the live read database (null = never published)
  liveVersionId    String?          @unique @map("live_version_id") @db.Uuid

  seller   Business         @relation(fields: [sellerBusinessId], references: [id])
  category Category         @relation(fields: [categoryId], references: [id])
  images   ListingImage[]
  versions ListingVersion[] @relation("ListingVersions")
  liveVersion ListingVersion? @relation("ListingLiveVersion", fields: [liveVersionId], references: [id])

  @@unique([sellerBusinessId, sku])
  @@index([sellerBusinessId])
  @@index([categoryId, status])
  @@index([searchTsv], map: "listings_search_tsv_idx", type: Gin)
  @@map("listings")
}

/// Seller-uploaded product image. Never public until a staff member with "images.moderate"
/// approves it; the seller sees their own pending/rejected images (with the note). Binary lives in
/// object storage via @cnote/media (storageKey), never in Postgres.
model ListingImage {
  id               String    @id @default(uuid()) @db.Uuid
  listingId        String    @map("listing_id") @db.Uuid
  sellerBusinessId String    @map("seller_business_id") @db.Uuid
  storageKey       String    @unique @map("storage_key")
  mimeType         String    @map("mime_type") // image/jpeg | image/png | image/webp
  bytes            Int
  width            Int?
  height           Int?
  /// sha256 of the bytes: dedupe per listing and block re-upload of rejected images
  sha256           String
  sortOrder        Int       @default(0) @map("sort_order")
  altText          String?   @map("alt_text")
  /// Resized derivatives generated on approval: [{ width, height, format: "avif"|"webp"|"jpeg", key, bytes }]
  variants         Json      @default("[]")
  /// tiny blurred placeholder (data URL, < 1 KB) shown while the real image loads
  blurDataUrl      String?   @map("blur_data_url")
  /// null = not processed yet; derivatives are (re)built by the catalogue worker
  processedAt      DateTime? @map("processed_at") @db.Timestamptz
  status           UgcStatus @default(pending)
  moderationNote   String?   @map("moderation_note") // shown to the seller on rejection
  aiVerdict        String?   @map("ai_verdict") // pre-screen only; never auto-approves
  moderatedBy      String?   @map("moderated_by") @db.Uuid // StaffMember id
  moderatedAt      DateTime? @map("moderated_at") @db.Timestamptz
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz

  listing Listing @relation(fields: [listingId], references: [id])

  @@index([listingId, status, sortOrder])
  @@index([status, createdAt])
  @@index([listingId, sha256])
  @@map("listing_images")
}

enum ListingVersionStatus {
  submitted // seller submitted this snapshot for review
  in_review // AI pre-screen flagged it (or policy requires staff) — waiting for a decision
  approved // cleared; waiting for its publishAt (or the next publisher run)
  published // projected to the live read database (the current live version)
  superseded // was live; replaced by a newer published version
  rejected
  withdrawn // seller pulled it before it went live

  @@map("listing_version_status")
}

/// Immutable snapshot of a listing as submitted (history + audit). The Listing row is the seller's
/// working copy; buyers only ever see a published version, served from the LIVE database.
model ListingVersion {
  id            String               @id @default(uuid()) @db.Uuid
  listingId     String               @map("listing_id") @db.Uuid
  version       Int
  /// full content: title, description, categoryId, attributes, pricePaise, priceUnit, moq, moqUnit, hsn, language, imageIds[]
  snapshot      Json
  /// field-level diff vs the previous published version (for reviewers + history UI)
  changes       Json                 @default("[]")
  changeNote    String?              @map("change_note")
  status        ListingVersionStatus @default(submitted)
  aiVerdict     String?              @map("ai_verdict")
  reviewNote    String?              @map("review_note")
  reviewedBy    String?              @map("reviewed_by") @db.Uuid // StaffMember id; null = auto-approved by policy
  reviewedAt    DateTime?            @map("reviewed_at") @db.Timestamptz
  /// scheduled go-live; null = at the next publisher run after approval
  publishAt     DateTime?            @map("publish_at") @db.Timestamptz
  publishedAt   DateTime?            @map("published_at") @db.Timestamptz
  createdBy     String               @map("created_by") @db.Uuid // person id
  createdAt     DateTime             @default(now()) @map("created_at") @db.Timestamptz

  listing   Listing  @relation("ListingVersions", fields: [listingId], references: [id])
  liveOf    Listing? @relation("ListingLiveVersion")

  @@unique([listingId, version])
  @@index([status, publishAt])
  @@map("listing_versions")
}

/// Seller voice notes used to draft listings (ADR-004). Audio is personal data: kept only with the
/// `voice_retention` consent, otherwise deleted right after transcription (retention job enforces).
model VoiceNote {
  id               String    @id @default(uuid()) @db.Uuid
  sellerBusinessId String    @map("seller_business_id") @db.Uuid
  personId         String    @map("person_id") @db.Uuid
  storageKey       String?   @unique @map("storage_key") // null once the audio is purged
  mimeType         String    @map("mime_type")
  durationMs       Int?      @map("duration_ms")
  language         String?
  transcript       String?
  transcriptConfidence Float? @map("transcript_confidence") @db.Real
  listingId        String?   @map("listing_id") @db.Uuid // draft created from it
  retainAudio      Boolean   @default(false) @map("retain_audio") // snapshot of voice_retention consent
  purgeAfter       DateTime  @map("purge_after") @db.Timestamptz
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@index([sellerBusinessId, createdAt])
  @@index([purgeAfter])
  @@map("voice_notes")
}
