// Cross-cutting: domain event log (@cnote/core events) and AI audit + human review (@cnote/ai).

/// Append-only domain event log / transactional outbox (ADR-007). Written in the same transaction
/// as the state change; the worker relays unpublished rows to Redis Streams. Only publishedAt is
/// ever updated.
model DomainEvent {
  id            BigInt    @id @default(autoincrement())
  type          String
  version       Int       @default(1)
  aggregateType String    @map("aggregate_type")
  aggregateId   String    @map("aggregate_id")
  payload       Json
  occurredAt    DateTime  @default(now()) @map("occurred_at") @db.Timestamptz
  publishedAt   DateTime? @map("published_at") @db.Timestamptz

  @@index([publishedAt, id])
  @@index([aggregateType, aggregateId])
  /// metrics (@cnote/metrics) aggregate by event type over time windows
  @@index([type, occurredAt])
  @@map("domain_events")
}

/// Every AI decision affecting a user, with redacted inputs (ADR-008 auditability, ADR-010).
model AiDecision {
  id            String   @id @default(uuid()) @db.Uuid
  capability    String
  provider      String
  modelId       String   @map("model_id")
  promptVersion String   @map("prompt_version")
  inputRedacted Json     @map("input_redacted")
  output        Json
  confidence    Float    @db.Real
  subjectType   String?  @map("subject_type")
  subjectId     String?  @map("subject_id")
  latencyMs     Int      @map("latency_ms")
  /// ADR-008 shadow mode: a candidate model's decision, logged beside the live one and never shown to users or reviewed.
  shadow        Boolean  @default(false)
  /// The live decision this shadow decision ran alongside.
  shadowOfId    String?  @map("shadow_of_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz

  reviews ReviewItem[]

  @@index([subjectType, subjectId])
  @@index([shadow, capability, createdAt])
  @@index([shadowOfId])
  @@map("ai_decisions")
}

enum ReviewStatus {
  open
  approved
  rejected

  @@map("review_status")
}

/// Human-in-the-loop queue for low-confidence AI outputs (ADR-002, ADR-008).
model ReviewItem {
  id           String       @id @default(uuid()) @db.Uuid
  capability   String
  subjectType  String       @map("subject_type") // "enquiry", "listing", ...
  subjectId    String       @map("subject_id")
  reason       String
  aiDecisionId String?      @map("ai_decision_id") @db.Uuid
  status       ReviewStatus @default(open)
  resolvedBy   String?      @map("resolved_by") @db.Uuid
  resolvedAt   DateTime?    @map("resolved_at") @db.Timestamptz
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz

  aiDecision AiDecision? @relation(fields: [aiDecisionId], references: [id])

  @@index([status, createdAt])
  @@map("review_queue")
}
