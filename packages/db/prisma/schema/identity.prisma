// Owned by @cnote/identity (Identity/Verification + consent ledger). ADR-003, ADR-007, ADR-010.

enum ConsentPurpose {
  matching
  marketing
  voice_retention
  counterparty_sharing
  /// share GST filings, escrow history and dispute record with an NBFC partner for underwriting (ADR-019)
  credit_underwriting
  /// cookie-banner choices of a signed-in person, mirrored so they follow the account across devices
  analytics_cookies
  marketing_cookies
  functional_cookies
  /// the SELLER app's cookie-banner choices (onboarding timing, referral attribution), kept apart from the buyer web's purposes
  seller_analytics_cookies
  seller_marketing_cookies

  @@map("consent_purpose")
}

enum VerificationKind {
  phone_otp
  gstin
  udyam
  document
  video_kyc
  audit
  mca

  @@map("verification_kind")
}

enum VerificationStatus {
  pending
  passed
  failed

  @@map("verification_status")
}

enum MemberRole {
  owner
  /// legacy: treated as `requester` (docs/design/buyer-approvals.md); kept so existing rows and the seller side keep working
  staff
  // buyer team roles (docs/design/buyer-approvals.md)
  admin
  requester
  approver
  finance
  viewer

  @@map("member_role")
}

model Person {
  id                String    @id @default(uuid()) @db.Uuid
  email             String?   @unique // lower-cased
  emailVerifiedAt   DateTime? @map("email_verified_at") @db.Timestamptz
  /// scrypt hash ("scrypt$N$r$p$salt$hash"); null for Google-only accounts
  passwordHash      String?   @map("password_hash")
  phone             String?   @unique // E.164, e.g. +919876543210; verified via OTP for T0
  phoneVerifiedAt   DateTime? @map("phone_verified_at") @db.Timestamptz
  name              String?
  avatarUrl         String?   @map("avatar_url")
  preferredLanguage String    @default("en") @map("preferred_language")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz
  /// DPDP erasure: PII nulled/tombstoned, row kept for referential integrity
  erasedAt          DateTime? @map("erased_at") @db.Timestamptz
  /// Last time the person signed in or a session was refreshed (coarse: updated at most once a day). Session rows are purged
  /// after 90 days, so this is the durable "last approached us" signal for the DPDP Rules inactivity erasure (compliance).
  lastActiveAt      DateTime? @map("last_active_at") @db.Timestamptz

  memberships    BusinessMember[]
  consents       Consent[]
  authIdentities AuthIdentity[]
  authSessions   AuthSession[]
  staffMember    StaffMember?
  enquiries   Enquiry[]
  messages    Message[]

  @@map("persons")
}

/// Buyer and seller are roles on one Business, not separate types (ADR-007).
model Business {
  id               String   @id @default(uuid()) @db.Uuid
  name             String
  gstin            String?  @unique
  udyam            String?
  /// Seller-declared MSME size class: micro | small | medium (null = not declared). Drives the IT Act s.43B(h) payment-due
  /// tracking (docs/design/purchase-orders.md); micro and small count, and an Udyam number must be on file.
  msmeCategory     String?  @map("msme_category")
  msmeDeclaredAt   DateTime? @map("msme_declared_at") @db.Timestamptz
  /// Company profile (seller-declared, verified against GST/MCA data)
  legalName        String?  @map("legal_name")
  tradeName        String?  @map("trade_name")
  /// proprietorship | partnership | llp | private_limited | public_limited | huf | other
  companyType      String?  @map("company_type")
  /// Corporate Identification Number (MCA) for companies/LLPs
  cin              String?
  /// PAN is personal/business identity data: store only when the business declares it (DPDP)
  pan              String?
  /// { line1, line2, city, state, stateCode, pincode }
  registeredAddress Json?   @map("registered_address")
  website          String?
  /// Latest GST check snapshot (full evidence lives in VerificationRecord.details)
  gstStatus        String?  @map("gst_status") // Active | Cancelled | Suspended | Inactive
  gstVerifiedAt    DateTime? @map("gst_verified_at") @db.Timestamptz
  gstLastCheckedAt DateTime? @map("gst_last_checked_at") @db.Timestamptz
  /// Udyam / MCA registry checks (ADR-003 T1). Evidence lives in VerificationRecord.details.
  udyamVerifiedAt  DateTime? @map("udyam_verified_at") @db.Timestamptz
  udyamLastCheckedAt DateTime? @map("udyam_last_checked_at") @db.Timestamptz
  mcaVerifiedAt    DateTime? @map("mca_verified_at") @db.Timestamptz
  mcaLastCheckedAt DateTime? @map("mca_last_checked_at") @db.Timestamptz
  /// Active | Struck Off | Under Liquidation | ... as reported by the MCA provider
  mcaStatus        String?   @map("mca_status")
  city             String?
  state            String?
  pincode          String?
  isSeller         Boolean  @default(false) @map("is_seller")
  isBuyer          Boolean  @default(true) @map("is_buyer")
  /// T0 phone/OTP, T1 GSTIN+Udyam, T2 docs+KYC, T3 audit
  verificationTier Int      @default(0) @map("verification_tier") @db.SmallInt
  /// 0–100 continuous trust score; decays; badge revoked below threshold
  trustScore       Int      @default(50) @map("trust_score") @db.SmallInt
  badgeActive      Boolean  @default(false) @map("badge_active")
  languages        String[] @default(["en"])
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz

  members       BusinessMember[]
  invites       BusinessInvite[]
  addresses     BusinessAddress[]
  verifications VerificationRecord[]
  listings      Listing[]
  enquiries     Enquiry[]
  matches       Match[]
  quotes        Quote[]
  dealReports   DealReport[]
  subscriptions Subscription[]
  creditLedger  CreditLedgerEntry[]
  // ads + promotions (ADR-024/025)
  adCampaigns        AdCampaign[]
  adWalletEntries    AdWalletEntry[]
  adTopUps           AdTopUp[]
  listingOffers      ListingOffer[]
  couponRedemptions  CouponRedemption[]
  referralsMade      Referral[] @relation("Referrer")
  referralsReceived  Referral[] @relation("Referee")

  @@index([isSeller, trustScore])
  @@map("businesses")
}

model BusinessMember {
  businessId String     @map("business_id") @db.Uuid
  personId   String     @map("person_id") @db.Uuid
  role       MemberRole @default(owner)

  business Business @relation(fields: [businessId], references: [id])
  person   Person   @relation(fields: [personId], references: [id])

  @@id([businessId, personId])
  @@map("business_members")
}

/// Pending/used invitation to join a business team (docs/design/buyer-approvals.md). Only the sha256 of the single-use token is
/// stored. The invitee's email is personal data (DPDP): exported to the inviter, purged after the retention window, erased with them.
model BusinessInvite {
  id                 String     @id @default(uuid()) @db.Uuid
  businessId         String     @map("business_id") @db.Uuid
  /// lower-cased
  email              String
  role               MemberRole
  tokenHash          String     @unique @map("token_hash")
  invitedByPersonId  String     @map("invited_by_person_id") @db.Uuid
  expiresAt          DateTime   @map("expires_at") @db.Timestamptz
  acceptedAt         DateTime?  @map("accepted_at") @db.Timestamptz
  acceptedByPersonId String?    @map("accepted_by_person_id") @db.Uuid
  revokedAt          DateTime?  @map("revoked_at") @db.Timestamptz
  createdAt          DateTime   @default(now()) @map("created_at") @db.Timestamptz

  business Business @relation(fields: [businessId], references: [id])

  @@index([businessId, createdAt])
  @@index([email])
  @@map("business_invites")
}

/// Saved delivery address of a business (buyer role). Personal data under DPDP: included in the data export and
/// deleted on erasure. `state` is derived from the pincode server-side; at most one default per business (kept in code).
model BusinessAddress {
  id          String   @id @default(uuid()) @db.Uuid
  businessId  String   @map("business_id") @db.Uuid
  label       String
  contactName String?  @map("contact_name")
  phone       String?
  line1       String
  line2       String?
  city        String
  state       String
  /// GST state code (01-38)
  stateCode   String   @map("state_code")
  pincode     String
  isDefault   Boolean  @default(false) @map("is_default")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  business Business @relation(fields: [businessId], references: [id])

  @@index([businessId, isDefault])
  @@map("business_addresses")
}

model VerificationRecord {
  id         String             @id @default(uuid()) @db.Uuid
  businessId String             @map("business_id") @db.Uuid
  tier       Int                @db.SmallInt
  kind       VerificationKind
  status     VerificationStatus
  provider   String
  details    Json               @default("{}")
  createdAt  DateTime           @default(now()) @map("created_at") @db.Timestamptz

  business Business @relation(fields: [businessId], references: [id])

  @@index([businessId])
  @@map("verification_records")
}

/// Append-only, purpose-scoped consent ledger. Current state = latest row per (person, purpose). ADR-010.
model Consent {
  id        String         @id @default(uuid()) @db.Uuid
  personId  String         @map("person_id") @db.Uuid
  purpose   ConsentPurpose
  granted   Boolean
  source    String // "web", "whatsapp", ...
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz

  person Person @relation(fields: [personId], references: [id])

  @@index([personId, purpose, createdAt])
  @@map("consents")
}

/// External login identities (Google today). ADR-010: store only what we need.
model AuthIdentity {
  id              String   @id @default(uuid()) @db.Uuid
  personId        String   @map("person_id") @db.Uuid
  provider        String // "google"
  providerSubject String   @map("provider_subject") // Google "sub"
  email           String?
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz

  person Person @relation(fields: [personId], references: [id])

  @@unique([provider, providerSubject])
  @@index([personId])
  @@map("auth_identities")
}

/// Durable login session behind the rotating refresh token. Short-lived JWT access tokens are
/// minted from it; Redis caches validity for fast revocation checks.
model AuthSession {
  id               String    @id @default(uuid()) @db.Uuid
  personId         String    @map("person_id") @db.Uuid
  /// "web" | "seller" | "admin" — each app is its own session realm: tokens, cookies and refresh
  /// sessions never cross realms (separate signing keys + JWT audience).
  realm            String    @default("web")
  /// sha256 of the current refresh token; rotated on every refresh
  refreshTokenHash String    @unique @map("refresh_token_hash")
  /// previous hash, kept to detect refresh-token reuse (→ revoke whole session)
  prevTokenHash    String?   @map("prev_token_hash")
  userAgent        String?   @map("user_agent")
  ip               String?
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz
  lastUsedAt       DateTime  @default(now()) @map("last_used_at") @db.Timestamptz
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz

  person Person @relation(fields: [personId], references: [id])

  @@index([personId, realm, revokedAt])
  @@map("auth_sessions")
}

/// TOTP multi-factor auth (required for admin realm; optional for sellers). Secret is encrypted with
/// @cnote/security field encryption; recovery codes are stored as sha256 hashes only.
model PersonMfa {
  personId          String    @id @map("person_id") @db.Uuid
  /// envelope-encrypted TOTP secret (base32), see @cnote/security encryptField
  totpSecretEnc     String?   @map("totp_secret_enc")
  enabledAt         DateTime? @map("enabled_at") @db.Timestamptz
  /// sha256 hashes of unused one-time recovery codes
  recoveryCodeHashes String[] @default([]) @map("recovery_code_hashes")
  /// last accepted TOTP time-step, to block code replay within the window
  lastUsedStep      BigInt?   @map("last_used_step")
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@map("person_mfa")
}

/// WebAuthn passkey (phishing-resistant second factor; ADR-029/ADR-042, docs/design/admin-passkeys.md). Realm-scoped so the
/// seller/buyer realms can adopt it later; only the admin realm is wired today. The public key is public by design (no
/// field encryption); revoked rows are kept (revokedAt) as a trail, and are deleted with the person on erasure.
model PersonPasskey {
  id           String    @id @default(uuid()) @db.Uuid
  personId     String    @map("person_id") @db.Uuid
  realm        String
  /// base64url credential id as sent by the authenticator
  credentialId String    @unique @map("credential_id")
  publicKey    Bytes     @map("public_key")
  signCount    BigInt    @default(0) @map("sign_count")
  transports   String[]  @default([])
  aaguid       String
  /// "singleDevice" | "multiDevice"
  deviceType   String    @map("device_type")
  backedUp     Boolean   @default(false) @map("backed_up")
  nickname     String
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  lastUsedAt   DateTime? @map("last_used_at") @db.Timestamptz
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz
  /// "user" | "reset" | "clone_suspected"
  revokedReason String?  @map("revoked_reason")

  @@index([personId, realm])
  @@map("person_passkeys")
}

// ---- T2 / T3 verification (ADR-003) — owned by @cnote/identity ------------------------------------------------

enum KycStatus {
  initiated
  in_progress // with the provider (document capture / video call)
  review // automated checks ambiguous → staff decision
  approved
  rejected
  expired

  @@map("kyc_status")
}

/// T2: document forensics (GST cert, PAN, bank proof, address proof) + liveness / video KYC via a provider port.
model KycSession {
  id               String    @id @default(uuid()) @db.Uuid
  businessId       String    @map("business_id") @db.Uuid
  personId         String    @map("person_id") @db.Uuid // the authorised signatory doing KYC
  provider         String // "hyperverge" | "signzy" | "idfy" | "mock"
  providerRef      String?   @unique @map("provider_ref")
  status           KycStatus @default(initiated)
  /// liveness / face-match scores and provider verdicts (no raw biometrics stored)
  livenessScore    Float?    @map("liveness_score") @db.Real
  faceMatchScore   Float?    @map("face_match_score") @db.Real
  outcome          Json      @default("{}")
  reviewNote       String?   @map("review_note")
  reviewedBy       String?   @map("reviewed_by") @db.Uuid
  completedAt      DateTime? @map("completed_at") @db.Timestamptz
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz

  documents KycDocument[]

  @@index([businessId, createdAt])
  @@index([status, createdAt])
  @@map("kyc_sessions")
}

model KycDocument {
  id            String   @id @default(uuid()) @db.Uuid
  sessionId     String   @map("session_id") @db.Uuid
  /// "gst_certificate" | "pan_card" | "bank_proof" | "address_proof" | "udyam_certificate"
  docType       String   @map("doc_type")
  /// private media key; purged after the KYC retention window
  storageKey    String?  @map("storage_key")
  sha256        String
  /// VLM/OCR extraction: { name, pan, gstin, address, issueDate, … } (PAN/Aadhaar stored masked)
  extracted     Json     @default("{}")
  /// forensic checks: { tamperScore, fontConsistency, metadataAnomalies, matchesDeclared: {...} }
  checks        Json     @default("{}")
  verdict       String   @default("pending") // pending | pass | fail | review
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz

  session KycSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("kyc_documents")
}

/// T3: physical / third-party audit by a partner agency (SGS, TÜV, local) when a category demands it.
model VerificationAudit {
  id            String    @id @default(uuid()) @db.Uuid
  businessId    String    @map("business_id") @db.Uuid
  partner       String // agency name / partner code
  status        String    @default("requested") // requested | scheduled | completed | failed | cancelled
  scheduledFor  DateTime? @map("scheduled_for") @db.Timestamptz
  /// private media key of the audit report
  reportKey     String?   @map("report_key")
  findings      Json      @default("{}")
  result        String? // pass | fail | conditional
  validUntil    DateTime? @map("valid_until") @db.Timestamptz
  requestedBy   String?   @map("requested_by") @db.Uuid // staff id
  /// Partner-submission flow: external partner record, single-use signed upload link (only the sha256 is stored),
  /// the partner's checklist + geotagged photo metadata, and the staff review (docs/design/verification-t2-t3.md).
  partnerId     String?   @map("partner_id") @db.Uuid
  uploadTokenHash String? @unique @map("upload_token_hash")
  uploadTokenExpiresAt DateTime? @map("upload_token_expires_at") @db.Timestamptz
  submission    Json?
  submittedAt   DateTime? @map("submitted_at") @db.Timestamptz
  reviewedBy    String?   @map("reviewed_by") @db.Uuid
  reviewNote    String?   @map("review_note")
  /// the T3 badge asks for a re-audit from this date (validUntil minus the lead time)
  reAuditDueAt  DateTime? @map("re_audit_due_at") @db.Timestamptz
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@index([businessId, createdAt])
  @@index([status])
  @@map("verification_audits")
}

/// External T3 audit agency (SGS, TUV, a local agency). Not a login: it only ever receives single-use upload links.
model AuditPartner {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  contactEmail String?  @map("contact_email")
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@map("audit_partners")
}
