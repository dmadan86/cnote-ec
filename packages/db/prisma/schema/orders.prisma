// Owned by @cnote/enquiry (orders sub-module). ADR-007: model the lifecycle now so Phase-2 escrow
// (ADR-012) and disputes (ADR-013) attach to real rows. Phase 1 orders are OFF-PLATFORM records created
// from an accepted quote / a "won" deal report — no money moves through the platform yet.

enum OrderStatus {
  recorded // created from a won deal / accepted quote (off-platform, Phase 1)
  confirmed // both parties confirmed the order terms
  dispatched
  delivered
  completed
  cancelled

  @@map("order_status")
}

/// Fulfilment sub-stages recorded by the seller alongside (never instead of) the main status machine, so escrow
/// milestones keyed on `OrderStatus` are unaffected. Order is forward-only: packed < in_transit < out_for_delivery < delivery_attempted.
enum FulfilmentStage {
  packed
  in_transit
  out_for_delivery
  delivery_attempted

  @@map("fulfilment_stage")
}

model Order {
  id               String      @id @default(uuid()) @db.Uuid
  /// null for orders that arrive from an external network (ONDC, ADR-017) rather than from a matched lead
  matchId          String?     @map("match_id") @db.Uuid
  enquiryId        String?     @map("enquiry_id") @db.Uuid
  quoteId          String?     @map("quote_id") @db.Uuid
  buyerBusinessId  String      @map("buyer_business_id") @db.Uuid
  sellerBusinessId String      @map("seller_business_id") @db.Uuid
  /// idempotency key for external orders, e.g. "ondc:<ondcOrderId>"
  externalRef      String?     @unique @map("external_ref")
  /// display label for an external buyer (network orders are booked to a per-network system business)
  externalBuyerLabel String?   @map("external_buyer_label")
  /// "off_platform" in Phase 1; "escrow" once funded through ADR-012; "ondc" for network orders
  settlement       String      @default("off_platform")
  status           OrderStatus @default(recorded)
  pricePaise       BigInt?     @map("price_paise") // per unit, from the quote when known
  quantity         Int?
  unit             String?
  totalPaise       BigInt?     @map("total_paise")
  currency         String      @default("INR")
  buyerConfirmedAt  DateTime?  @map("buyer_confirmed_at") @db.Timestamptz
  sellerConfirmedAt DateTime?  @map("seller_confirmed_at") @db.Timestamptz
  /// latest fulfilment sub-stage (null until the seller records one); history is in OrderFulfilmentEvent
  fulfilmentStage  FulfilmentStage? @map("fulfilment_stage")
  fulfilmentUpdatedAt DateTime? @map("fulfilment_updated_at") @db.Timestamptz
  /// latest tracking reference (courier name + AWB), optional
  trackingCourier  String?     @map("tracking_courier")
  trackingRef      String?     @map("tracking_ref")
  createdAt        DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  fulfilmentEvents OrderFulfilmentEvent[]

  @@unique([matchId])
  @@index([buyerBusinessId, createdAt])
  @@index([sellerBusinessId, createdAt])
  @@map("orders")
}

/// Append-only history of fulfilment sub-stages (one row per recorded move). Never updated or deleted by the app.
model OrderFulfilmentEvent {
  id              String          @id @default(uuid()) @db.Uuid
  orderId         String          @map("order_id") @db.Uuid
  stage           FulfilmentStage
  note            String?
  courier         String?
  trackingRef     String?         @map("tracking_ref")
  /// the seller business that recorded it
  actorBusinessId String          @map("actor_business_id") @db.Uuid
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz
  order           Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@map("order_fulfilment_events")
}
