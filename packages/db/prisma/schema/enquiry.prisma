// Owned by @cnote/enquiry (Enquiry & Matching + Messaging). ADR-002, ADR-007.
// Phase-2 Order / EscrowTransaction / Dispute models are intentionally absent; Quote and DealReport
// keep the enquiry → quote → deal lifecycle complete for off-platform deals.

enum EnquiryStatus {
  scoring
  review
  matched
  unmatched
  closed
  rejected

  @@map("enquiry_status")
}

enum MatchStatus {
  offered
  accepted
  declined
  expired
  refunded

  @@map("match_status")
}

enum DealOutcome {
  won
  lost
  pending

  @@map("deal_outcome")
}

model Enquiry {
  id               String           @id @default(uuid()) @db.Uuid
  buyerBusinessId  String           @map("buyer_business_id") @db.Uuid
  buyerPersonId    String           @map("buyer_person_id") @db.Uuid
  categoryId       String?          @map("category_id") @db.Uuid
  title            String
  requirement      String
  quantity         Int?
  quantityUnit     String?          @map("quantity_unit")
  targetPricePaise BigInt?          @map("target_price_paise")
  deliveryCity     String?          @map("delivery_city")
  deliveryPincode  String?          @map("delivery_pincode")
  neededBy         DateTime?        @map("needed_by") @db.Date
  language         String           @default("en")
  /// 0–100, visible to sellers (ADR-002)
  intentScore      Int?             @map("intent_score")
  intentReasons    Json             @default("[]") @map("intent_reasons")
  /// pgvector; read/write via $queryRaw
  embedding        Unsupported("vector(256)")?
  embeddingVersion String?          @map("embedding_version")
  moderationStatus ModerationStatus @default(pending) @map("moderation_status")
  status           EnquiryStatus    @default(scoring)
  sellerCap        Int              @default(3) @map("seller_cap")
  /// ADR-002 option 4: buyer picks sellers manually from a ranked list
  buyerPicks       Boolean          @default(false) @map("buyer_picks")
  /// Optional budget range per unit, integer paise (min <= max enforced in code).
  budgetMinPaise   BigInt?          @map("budget_min_paise")
  budgetMaxPaise   BigInt?          @map("budget_max_paise")
  /// Quote expiry: after this the requirement is "expired" on the buyer board and sellers can no longer accept it. Null = legacy rows (no expiry).
  expiresAt        DateTime?        @map("expires_at") @db.Timestamptz
  /// Preferred supplier tier: only sellers at this verification tier or above are matched. Null = any.
  minSellerTier    Int?             @map("min_seller_tier")
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz

  buyer       Business  @relation(fields: [buyerBusinessId], references: [id])
  buyerPerson Person    @relation(fields: [buyerPersonId], references: [id])
  category    Category? @relation(fields: [categoryId], references: [id])
  matches     Match[]
  attachments EnquiryAttachment[]

  @@index([buyerBusinessId, createdAt])
  @@map("enquiries")
}

model Match {
  id               String      @id @default(uuid()) @db.Uuid
  enquiryId        String      @map("enquiry_id") @db.Uuid
  sellerBusinessId String      @map("seller_business_id") @db.Uuid
  rank             Int // 1-based among the offered set
  matchScore       Float       @map("match_score") @db.Real
  status           MatchStatus @default(offered)
  offeredAt        DateTime    @default(now()) @map("offered_at") @db.Timestamptz
  /// offeredAt + 2h; after that the slot cascades to the next-ranked seller
  respondBy        DateTime    @map("respond_by") @db.Timestamptz
  respondedAt      DateTime?   @map("responded_at") @db.Timestamptz
  /// credit_ledger row consumed on accept; refunded per ADR-002 auto-refund
  creditTxnId      String?     @map("credit_txn_id") @db.Uuid
  /// why an accepted lead was refunded: buyer_unreachable | buyer_fake | enquiry_rejected
  refundReason     String?     @map("refund_reason")

  enquiry      Enquiry       @relation(fields: [enquiryId], references: [id])
  seller       Business      @relation(fields: [sellerBusinessId], references: [id])
  conversation Conversation?
  dealReports  DealReport[]

  @@unique([enquiryId, sellerBusinessId])
  @@index([sellerBusinessId, status])
  @@index([status, respondBy])
  @@index([enquiryId, refundReason])
  @@map("matches")
}

model Conversation {
  id        String   @id @default(uuid()) @db.Uuid
  matchId   String   @unique @map("match_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  match    Match     @relation(fields: [matchId], references: [id])
  messages Message[]
  quotes   Quote[]

  @@map("conversations")
}

model Message {
  id             String   @id @default(uuid()) @db.Uuid
  conversationId String   @map("conversation_id") @db.Uuid
  senderPersonId String   @map("sender_person_id") @db.Uuid
  body           String
  language       String   @default("en")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  conversation Conversation @relation(fields: [conversationId], references: [id])
  sender       Person       @relation(fields: [senderPersonId], references: [id])

  @@index([conversationId, createdAt])
  @@map("messages")
}

model Quote {
  id               String    @id @default(uuid()) @db.Uuid
  conversationId   String    @map("conversation_id") @db.Uuid
  sellerBusinessId String    @map("seller_business_id") @db.Uuid
  pricePaise       BigInt    @map("price_paise") // per unit
  quantity         Int
  unit             String
  leadTimeDays     Int?      @map("lead_time_days")
  notes            String?
  validUntil       DateTime? @map("valid_until") @db.Date
  /// Structured, optional terms (ADR-014 follow-up). Enum-ish strings validated in code: delivery ex_works|fob|door_delivery|buyer_pickup|other;
  /// payment advance|on_delivery|net_7|net_15|net_30|escrow|other.
  moq                 Int?
  moqUnit             String?  @map("moq_unit")
  deliveryTerms       String?  @map("delivery_terms")
  deliveryNote        String?  @map("delivery_note")
  deliveryChargePaise BigInt?  @map("delivery_charge_paise")
  paymentTerms        String?  @map("payment_terms")
  paymentNote         String?  @map("payment_note")
  gstIncluded         Boolean? @map("gst_included")
  /// Set when the buyer shortlists this quote on the comparison table; null = not shortlisted. Buyer-only state.
  shortlistedAt    DateTime? @map("shortlisted_at") @db.Timestamptz
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz

  conversation Conversation @relation(fields: [conversationId], references: [id])
  seller       Business     @relation(fields: [sellerBusinessId], references: [id])
  attachments  EnquiryAttachment[]

  /// Seller quote history, keyset-paged (createdAt desc, id desc).
  @@index([sellerBusinessId, createdAt(sort: Desc), id(sort: Desc)])
  @@map("quotes")
}

/// Drawings/specs on a requirement (quoteId null, uploaded by the buyer) or on a seller's quote (quoteId set).
/// Bytes live in the PRIVATE media bucket under `rfq/<enquiryId>/<id>.<ext>`; read via authorised, short-lived URLs only.
model EnquiryAttachment {
  id                 String   @id @default(uuid()) @db.Uuid
  enquiryId          String   @map("enquiry_id") @db.Uuid
  quoteId            String?  @map("quote_id") @db.Uuid
  uploadedByBusiness String   @map("uploaded_by_business") @db.Uuid
  key                String   @unique
  fileName           String   @map("file_name")
  mimeType           String   @map("mime_type")
  sizeBytes          Int      @map("size_bytes")
  /// Malware scan evidence: the row only exists after a clean verdict, so a file is never visible unscanned. Null = uploaded before scanning existed.
  scannedAt          DateTime? @map("scanned_at") @db.Timestamptz
  scanner            String?
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz

  enquiry Enquiry @relation(fields: [enquiryId], references: [id])
  quote   Quote?  @relation(fields: [quoteId], references: [id])

  @@index([enquiryId])
  @@index([quoteId])
  @@map("enquiry_attachments")
}

/// An upload the malware scanner flagged. The bytes sit under `quarantine/…` in the PRIVATE bucket and are never served;
/// no EnquiryAttachment row is created, so the file is never visible to the other party. Purged after RETENTION_ATTACHMENT_QUARANTINE_DAYS.
/// `enquiryId` is not a foreign key: a blocked RFQ upload means the enquiry itself was never created.
model AttachmentQuarantine {
  id                  String    @id @default(uuid()) @db.Uuid
  enquiryId           String    @map("enquiry_id") @db.Uuid
  /// "rfq" (buyer requirement) | "quote" (seller quote)
  kind                String
  uploadedByBusiness  String    @map("uploaded_by_business") @db.Uuid
  uploadedByPerson    String    @map("uploaded_by_person") @db.Uuid
  key                 String    @unique
  fileName            String    @map("file_name")
  mimeType            String    @map("mime_type")
  sizeBytes           Int       @map("size_bytes")
  signature           String
  scanner             String
  detectedAt          DateTime  @default(now()) @map("detected_at") @db.Timestamptz
  /// set when the bytes were deleted by the retention purge (the row stays as the audit record)
  purgedAt            DateTime? @map("purged_at") @db.Timestamptz

  @@index([detectedAt])
  @@map("attachment_quarantine")
}

/// One-tap "did this close?" reports for off-platform deals (ADR-007).
model DealReport {
  id                   String      @id @default(uuid()) @db.Uuid
  matchId              String      @map("match_id") @db.Uuid
  reportedByBusinessId String      @map("reported_by_business_id") @db.Uuid
  outcome              DealOutcome
  valuePaise           BigInt?     @map("value_paise")
  createdAt            DateTime    @default(now()) @map("created_at") @db.Timestamptz

  match      Match    @relation(fields: [matchId], references: [id])
  reportedBy Business @relation(fields: [reportedByBusinessId], references: [id])

  @@map("deal_reports")
}

/// ADR-002: automated buyer reachability check before an "unreachable" auto-refund is granted (and on intake for
/// low-intent enquiries). A WhatsApp/SMS ping with a one-tap reply, optionally an IVR call via a telephony port.
model ReachabilityCheck {
  id          String    @id @default(uuid()) @db.Uuid
  enquiryId   String    @map("enquiry_id") @db.Uuid
  matchId     String?   @map("match_id") @db.Uuid // set when triggered by a seller's "unreachable" report
  channel     String // "whatsapp" | "sms" | "ivr"
  /// sent | responded | no_response | failed
  status      String    @default("sent")
  /// opaque token in the reply link / button payload
  token       String    @unique
  respondedAt DateTime? @map("responded_at") @db.Timestamptz
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  /// seller_report (old path) | proactive (automatic, after the enquiry)
  trigger     String    @default("seller_report")
  /// IVR call reference at the telephony provider
  providerRef String?   @unique @map("provider_ref")
  /// 1 = IVR/first channel, 2 = fallback link after the call went unanswered
  attempt     Int       @default(1)

  @@index([enquiryId])
  @@index([status, expiresAt])
  @@map("reachability_checks")
}

/// Security audit M2: a seller's "buyer_fake" refund request that tripped the per-seller refund guard (rate / burst). The
/// credit is NOT returned until staff decide; approving refunds the match, rejecting leaves it accepted.
model LeadRefundReview {
  id               String    @id @default(uuid()) @db.Uuid
  /// one hold per match
  matchId          String    @unique @map("match_id") @db.Uuid
  enquiryId        String    @map("enquiry_id") @db.Uuid
  sellerBusinessId String    @map("seller_business_id") @db.Uuid
  /// buyer_fake
  kind             String
  /// refund_rate | refund_burst
  reason           String
  /// the seller's refund rate (bps of accepted leads, 30d) when it was held
  refundRateBps    Int       @map("refund_rate_bps")
  /// pending | approved | rejected
  status           String    @default("pending")
  decidedBy        String?   @map("decided_by") @db.Uuid
  decidedAt        DateTime? @map("decided_at") @db.Timestamptz
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@index([status, createdAt])
  @@index([sellerBusinessId, status])
  @@map("lead_refund_reviews")
}

/// ADR-002 fake-lead signals, collected server-side at enquiry creation. Privacy: no raw IP, no device cookie. `ipHash` is a
/// keyed hash of the /24 (IPv4) or /48 (IPv6) prefix; velocity counts are per person and ip-prefix. Purged after 90 days
/// (hash nulled, labels kept). `label` is the ops ground truth used for precision/recall.
model EnquirySignals {
  id                String    @id @default(uuid()) @db.Uuid
  enquiryId         String    @unique @map("enquiry_id") @db.Uuid
  ipHash            String?   @map("ip_hash")
  uaFamily          String    @map("ua_family")
  velocityPerson1h  Int       @default(0) @map("velocity_person_1h")
  velocityPerson24h Int       @default(0) @map("velocity_person_24h")
  velocityIp24h     Int       @default(0) @map("velocity_ip_24h")
  riskScore         Int       @map("risk_score") @db.SmallInt
  riskReasons       String[]  @map("risk_reasons")
  /// genuine | fake | spam | unreachable (ops label)
  label             String?
  labelledBy        String?   @map("labelled_by") @db.Uuid
  labelledAt        DateTime? @map("labelled_at") @db.Timestamptz
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@index([label, createdAt])
  @@index([ipHash, createdAt])
  @@map("enquiry_signals")
}
