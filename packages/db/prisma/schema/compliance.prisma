// Owned by @cnote/compliance: DPDP grievance redressal, takedown appeals, retention run log, cookie consent receipts (ADR-010).

enum ComplianceCaseStatus {
  open
  in_progress
  resolved
  rejected

  @@map("compliance_case_status")
}

/// DPDP Act grievance (data principal complaint) handled by the Grievance Officer within the statutory window.
model GrievanceTicket {
  id          String               @id @default(uuid()) @db.Uuid
  personId    String?              @map("person_id") @db.Uuid // null when raised without an account
  /// contact for anonymous raisers; masked in admin lists
  contactEmail String?             @map("contact_email")
  category    String // "access" | "correction" | "erasure" | "consent" | "content" | "other"
  /// DPDP data-principal right or complaint: "access" | "correction" | "erasure" | "nomination" | "withdraw_consent" | "complaint"
  requestType String               @default("complaint") @map("request_type")
  /// days allowed to resolve (dueAt = createdAt + slaDays): rights requests 90 (DPDP Rules 2025), complaints per policy
  slaDays     Int                  @default(15) @map("sla_days")
  /// optional cookie consent id (cnote_consent) the raiser refers to, so the Grievance Officer can pull the receipts
  consentId   String?              @map("consent_id")
  subject     String
  body        String
  status      ComplianceCaseStatus @default(open)
  /// statutory response deadline (configurable, default 30 days)
  dueAt       DateTime             @map("due_at") @db.Timestamptz
  resolution  String?
  handledBy   String?              @map("handled_by") @db.Uuid // StaffMember id
  resolvedAt  DateTime?            @map("resolved_at") @db.Timestamptz
  createdAt   DateTime             @default(now()) @map("created_at") @db.Timestamptz
  /// the raiser proved control of contactEmail (signed link) or was signed in. An anonymous rights request (access/erasure/
  /// correction/...) is not actionable until this is set; the SLA clock starts then. Existing rows were backfilled as verified.
  contactVerifiedAt DateTime?      @map("contact_verified_at") @db.Timestamptz

  @@index([status, dueAt])
  @@index([requestType, status])
  @@map("grievance_tickets")
}

/// A seller/user appeal against a moderation decision (listing, listing version, image, review/comment, storefront).
model ModerationAppeal {
  id          String               @id @default(uuid()) @db.Uuid
  personId    String               @map("person_id") @db.Uuid
  businessId  String?              @map("business_id") @db.Uuid
  subjectType String               @map("subject_type") // "listing_version" | "listing_image" | "review" | "comment" | "storefront_version"
  subjectId   String               @map("subject_id") @db.Uuid
  reason      String
  status      ComplianceCaseStatus @default(open)
  decisionNote String?             @map("decision_note")
  decidedBy   String?              @map("decided_by") @db.Uuid
  decidedAt   DateTime?            @map("decided_at") @db.Timestamptz
  createdAt   DateTime             @default(now()) @map("created_at") @db.Timestamptz

  @@unique([subjectType, subjectId, personId])
  @@index([status, createdAt])
  @@map("moderation_appeals")
}

/// Audit of every retention purge (what policy ran, how many rows) — evidence for DPDP storage limitation.
model RetentionRun {
  id        String   @id @default(uuid()) @db.Uuid
  policy    String // e.g. "messages.closed_enquiries_365d"
  module    String
  purged    Int
  startedAt DateTime @map("started_at") @db.Timestamptz
  finishedAt DateTime @map("finished_at") @db.Timestamptz
  error     String?

  @@index([policy, startedAt])
  @@map("retention_runs")
}

/// Proof of consent for cookie / browser-storage choices (DPDP Act s.6(10) burden of proof on the Data Fiduciary;
/// GDPR Art 7(1)). Append-only: one row per choice or change, never updated. Deliberately holds NO IP address and NO user
/// agent. `consentId` is the random id in the browser's `cnote_consent` cookie (it identifies a browser, not a person);
/// `personId` is set only when the visitor was signed in. Purged after 3 years by the `compliance.cookie_consent_receipts`
/// retention policy.
model CookieConsentReceipt {
  id            String   @id @default(uuid()) @db.Uuid
  consentId     String   @map("consent_id")
  /// which app showed the notice: "web" | "seller" (| "studio" | "admin" if they ever need a banner). Cookies are host-scoped per
  /// app, so each app has its own consent, registry and policy version; `policy_version` is per `app`. Rows from before this
  /// column are all the buyer web.
  app           String   @default("web")
  policyVersion Int      @map("policy_version")
  /// per-category choices (strictly necessary is always on and needs no consent)
  analytics     Boolean
  marketing     Boolean
  /// preferences & personalisation (e.g. recently viewed); false on rows from before this category existed
  functional    Boolean  @default(false)
  /// the Global Privacy Control signal was on when the choice was made
  gpc           Boolean
  /// "accept_all" | "reject_all" | "custom" | "withdraw"
  action        String
  locale        String
  personId      String?  @map("person_id") @db.Uuid
  /// unix seconds the browser stamped on the choice (`t` in the cookie). With consentId it makes POST /api/consent
  /// idempotent: a resend of the same receipt is a no-op. Null on rows written before this column existed.
  clientAt      Int?     @map("client_at")
  /// sha256 of the committed policy snapshot (registry + notice strings) the visitor saw; null on older rows
  registryHash  String?  @map("registry_hash")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@unique([consentId, clientAt])
  @@index([consentId, createdAt])
  @@index([personId, createdAt])
  @@index([createdAt])
  @@map("cookie_consent_receipts")
}

// ---- DPDP Rules 2025: inactivity erasure notice (r.8 / Third Schedule) and nominee (s.14, r.14) -----------------------------

/// Notice that a personal account will be erased for inactivity, sent at least 48 hours before (DPDP Rules 2025 r.8(2) / Third
/// Schedule). Erasure happens only after `eraseAfter` and only if the person has not signed in since `noticedAt`.
model InactivityErasureNotice {
  id           String    @id @default(uuid()) @db.Uuid
  personId     String    @map("person_id") @db.Uuid
  /// the last activity the decision was based on
  lastActiveAt DateTime  @map("last_active_at") @db.Timestamptz
  noticedAt    DateTime  @default(now()) @map("noticed_at") @db.Timestamptz
  /// earliest moment erasure may run (>= noticedAt + the notice period, itself >= 48h)
  eraseAfter   DateTime  @map("erase_after") @db.Timestamptz
  /// "pending" | "erased" | "cancelled"
  status       String    @default("pending")
  /// "erased" | "activity_since_notice" | "already_erased" | "api_activity_since_notice"
  resolution   String?
  resolvedAt   DateTime? @map("resolved_at") @db.Timestamptz

  @@index([status, eraseAfter])
  @@index([personId])
  @@map("inactivity_erasure_notices")
}

/// A person a data principal nominated to exercise their rights in the event of death or incapacity (DPDP Act s.14; Rules r.14).
/// Name, contact and relationship are encrypted with @cnote/security field encryption; `contactIndex` is a blind index so staff can
/// match a nominee's request to the nomination without decrypting every row.
model DataNominee {
  id              String    @id @default(uuid()) @db.Uuid
  personId        String    @map("person_id") @db.Uuid
  nameEnc         String    @map("name_enc")
  contactEnc      String    @map("contact_enc")
  relationshipEnc String    @map("relationship_enc")
  contactIndex    String    @map("contact_index")
  /// "active" | "revoked"
  status          String    @default("active")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  revokedAt       DateTime? @map("revoked_at") @db.Timestamptz

  @@index([personId, status])
  @@index([contactIndex])
  @@map("data_nominees")
}

/// A nominee's request to exercise the principal's rights (death / incapacity). Public intake, staff verification (the nominee
/// must match an active nomination AND staff check the supporting documents offline), then an audited action.
model NomineeRequest {
  id               String    @id @default(uuid()) @db.Uuid
  /// the principal; null when the email given matched no account (the requester is told the same thing either way)
  personId         String?   @map("person_id") @db.Uuid
  requesterNameEnc    String @map("requester_name_enc")
  requesterContactEnc String @map("requester_contact_enc")
  contactIndex     String    @map("contact_index")
  /// "death" | "incapacity"
  ground           String
  messageEnc       String    @map("message_enc")
  /// the requester's contact equals the contact of an active nomination of that person (computed at filing, re-checked at verification)
  nomineeMatched   Boolean   @map("nominee_matched")
  /// "received" | "verified" | "rejected" | "completed"
  status           String    @default("received")
  /// staff's note on the documents checked / the reason for rejection
  reviewNote       String?   @map("review_note")
  reviewedBy       String?   @map("reviewed_by") @db.Uuid
  reviewedAt       DateTime? @map("reviewed_at") @db.Timestamptz
  /// "erase_account" | "release_export" | "correct" | "other"
  actionTaken      String?   @map("action_taken")
  actionNote       String?   @map("action_note")
  completedAt      DateTime? @map("completed_at") @db.Timestamptz
  /// answer by (rights requests: 90 days, DPDP Rules 2025)
  dueAt            DateTime  @map("due_at") @db.Timestamptz
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@index([status, dueAt])
  @@index([personId])
  @@map("nominee_requests")
}
