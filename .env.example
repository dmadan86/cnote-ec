DATABASE_URL=postgres://cnote:cnote@localhost:5432/cnote
REDIS_URL=redis://localhost:6379
# AI provider for reasoning capabilities: "heuristic" (offline, default) or "anthropic"
AI_PROVIDER=heuristic
ANTHROPIC_API_KEY=
# In dev, OTPs are logged to the server console instead of sent by SMS/WhatsApp
OTP_DEV_ECHO=true
# Auth (packages/identity). JWT_SECRET: 32+ random bytes, e.g. `openssl rand -base64 48`
JWT_SECRET=dev-only-insecure-jwt-secret-change-me-please-0123456789
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APP_URL=http://localhost:3000
# Comma-separated emails with access to /ops (review queue, moderation)
OPS_EMAILS=ops@example.com
