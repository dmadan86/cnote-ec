DATABASE_URL=postgres://cnote:cnote@localhost:5432/cnote
# Local Redis: brew services (no password) as below, OR docker compose (requirepass, REDIS_PASSWORD default cnote-dev-redis):
#   REDIS_URL=redis://:cnote-dev-redis@localhost:6379
# Production: rediss:// (TLS) is REQUIRED unless REDIS_TLS_OPTIONAL=1 (private network, documented); see "Production" below.
REDIS_URL=redis://localhost:6379
# AI provider for reasoning capabilities: "heuristic" (offline, default) or "anthropic"
AI_PROVIDER=heuristic
ANTHROPIC_API_KEY=
# Shadow mode (ADR-008, docs/guides/ai-evals.md): run a candidate beside the live provider; decisions are logged with shadow=true and never reach users
# AI_SHADOW_PROVIDER=anthropic
# AI_SHADOW_MODEL_REASONING=
# AI_SHADOW_MODEL_FAST=
# In dev, OTPs are logged to the server console instead of sent by SMS/WhatsApp
# Local dev only: returns the OTP to the caller (console sender only). With NODE_ENV=production it fails startup validation;
# ALLOW_OTP_ECHO_IN_PRODUCTION=1 is the e2e / dev-overlay-only opt-out (packages/identity/src/dev-echo.ts).
OTP_DEV_ECHO=true
# Auth (packages/identity). JWT_SECRET: 32+ random bytes, e.g. `openssl rand -base64 48`
JWT_SECRET=dev-only-insecure-jwt-secret-change-me-please-0123456789
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APP_URL=http://localhost:3000
# Admin access is granted via `pnpm admin:grant <email> <role...>` (packages/admin), not env.
ADMIN_APP_URL=http://localhost:3001
SELLER_APP_URL=http://localhost:3002

# Local object storage (dev) for @cnote/media
MEDIA_DRIVER=local
MEDIA_DIR=.data/media

# Sentry (all apps + worker). Leave empty to disable. Browser DSN must be NEXT_PUBLIC_*.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=
# Build-time source-map upload (CI/deploy only)
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT_WEB=
SENTRY_PROJECT_SELLER=
SENTRY_PROJECT_ADMIN=

# Microsoft Clarity (buyer web only; loads only after analytics consent). Leave empty to disable.
NEXT_PUBLIC_CLARITY_PROJECT_ID=

# Public REST API + MCP (apps/api)
API_PUBLIC_URL=http://localhost:3003
API_CORS_ORIGINS=http://localhost:3000,http://localhost:3002
API_RATE_LIMIT_PER_MIN=120

# Cache purge: shared secret between the cache worker and POST /api/revalidate on the web app (leave empty to disable in dev)
REVALIDATE_SECRET=

# Live read database (CQRS): buyers read published projections only. Can be a separate cluster.
LIVE_DATABASE_URL=postgres://cnote:cnote@localhost:5432/cnote_live

# Search backend: postgres (default) | opensearch — see docs/design/search-index.md
SEARCH_BACKEND=postgres
OPENSEARCH_URL=
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=

# Object storage (@cnote/media): local | r2 | s3 | azure | gcs. Cloudflare R2 example:
#   MEDIA_DRIVER=r2  MEDIA_ENDPOINT=https://<account>.r2.cloudflarestorage.com  MEDIA_REGION=auto
MEDIA_BUCKET=
MEDIA_PRIVATE_BUCKET=
MEDIA_ENDPOINT=
MEDIA_REGION=
MEDIA_ACCESS_KEY_ID=
MEDIA_SECRET_ACCESS_KEY=
MEDIA_PUBLIC_BASE_URL=

# Storefront hosting + custom domains (@cnote/domains) — see docs/design/custom-domains.md
STOREFRONT_ROOT_DOMAIN=localhost
STOREFRONT_CNAME_TARGET=stores.example.com
STOREFRONT_APEX_IPS=
PLATFORM_HOSTS=localhost,127.0.0.1
EDGE_PROVIDER=mock
CF_API_TOKEN=
CF_ZONE_ID=
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
DOMAINS_DNS_RESOLVERS=1.1.1.1,8.8.8.8
DOMAINS_HTTP_PROBE=false
# Dedicated secret for the custom-domain probe (HKDF-derived; NOT shared with JWT_SECRET). `openssl rand -base64 32`. Required when the probe is on.
DOMAIN_CHECK_SECRET=
# Unverified custom-domain claims expire after this many days (anti-squatting)
DOMAINS_PENDING_CLAIM_DAYS=7
# Listing auto-approval gates (besides tier/trust): account age, staff-approved history, post-publication audit sample
LISTING_AUTO_APPROVE_MIN_ACCOUNT_AGE_DAYS=30
LISTING_AUTO_APPROVE_MIN_HUMAN_APPROVED=3
LISTING_AUTO_APPROVE_SAMPLE_RATE=0.05
# Review/Q&A report brigading: reporters must be verified and at least this old to count toward auto-hide
REVIEWS_REPORTER_MIN_AGE_DAYS=7
STUDIO_APP_URL=http://localhost:3004

# GST verification provider (@cnote/identity gst): mock | cashfree | surepass
GST_PROVIDER=mock
GST_PROVIDER_KEY=
GST_PROVIDER_SECRET=
GST_PROVIDER_BASE_URL=

# Signed preview links for unpublished listing versions (falls back to JWT_SECRET)
PREVIEW_TOKEN_SECRET=

# Security (packages/security; see docs/security/security-architecture.md)
# CSP_REPORT_ONLY=1                       # observe violations without enforcing (roll out first)
# CSP_STRICT_STYLES=0
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=         # Cloudflare Turnstile (web + seller sign-up, OTP). Unset = widget hidden, dev verifier passes
# TURNSTILE_SECRET=
# HUMAN_VERIFIER=turnstile                # turnstile | hcaptcha | recaptcha | off
# FIELD_ENCRYPTION_KEYS=                  # kid1:base64key[,kid2:base64key]  (openssl rand -base64 32); first is active
# FIELD_ENCRYPTION_ACTIVE_KID=
# BLIND_INDEX_KEY=                        # openssl rand -base64 32
# MFA_ISSUER=Cnote
# MFA_ADMIN_OPTIONAL=0                    # dev only: let admins sign in without MFA (ignored in production)
# --- passkeys / WebAuthn (admin realm; docs/design/admin-passkeys.md). Off by default. Pattern is <REALM>_..., only ADMIN is wired.
# ADMIN_PASSKEYS_ENABLED=0                # 1 = staff may register passkeys and sign in with them (preferred over TOTP)
# ADMIN_REQUIRE_PASSKEY=0                 # 1 = policy: staff without a passkey must enroll one after TOTP; TOTP/recovery codes are refused once they have one
# ADMIN_WEBAUTHN_RP_ID=                   # production: registrable domain, e.g. example.com (dev default: host of ADMIN_APP_URL)
# ADMIN_WEBAUTHN_ORIGIN=                  # production: exact https origin of the admin app, e.g. https://admin.example.com (dev default: ADMIN_APP_URL)

# App origins (storefront Studio + cross-app links)
SELLER_APP_URL=http://localhost:3002
NEXT_PUBLIC_SELLER_APP_URL=http://localhost:3002
NEXT_PUBLIC_STUDIO_APP_URL=http://localhost:3004

# Postgres pool size per process (default 10; builds use 2)
DATABASE_POOL_MAX=10

# Payments (hosted checkout; no card data held): mock | razorpay | cashfree
PAYMENTS_PROVIDER=mock
# E2E ONLY, default OFF. Lets the mock gateway run in a production build (the Playwright servers). Never set it on a real
# deployment: it is ignored (with an error log) when PAYMENTS_PROVIDER is razorpay/cashfree, and logs a loud warning when on.
# PAYMENTS_ALLOW_MOCK_IN_PRODUCTION=1
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_WEBHOOK_SECRET=
# GST invoicing (our GSTIN/state for CGST+SGST vs IGST; SAC for the service)
PLATFORM_LEGAL_NAME=
PLATFORM_GSTIN=
PLATFORM_STATE_CODE=29
PLATFORM_SAC=998314
PLATFORM_ADDRESS=
PLATFORM_GST_RATE_BPS=1800
# Legal entity and support contact shown in the buyer web footer and on /contact (Consumer Protection (E-Commerce) Rules 2020;
# apps/web/src/features/legal/entity.ts). PLATFORM_LEGAL_NAME, PLATFORM_GSTIN and PLATFORM_ADDRESS above are shared with invoicing.
# Unset values render a "[... not configured]" placeholder in dev. Production must set ALL of them: when NODE_ENV=production the
# web server REFUSES TO START if any is missing (strict by default). Set LEGAL_ENTITY_STRICT=false to opt out (local production
# builds, preview deploys); the server then only logs an error. Outside production nothing is enforced.
PLATFORM_CIN=
SUPPORT_EMAIL=
SUPPORT_PHONE=
SUPPORT_WHATSAPP=
SUPPORT_HOURS=
# LEGAL_ENTITY_STRICT=false
# Contact and policy for /.well-known/security.txt (RFC 9116). The policy URL is APP_URL + /security.
SECURITY_CONTACT_EMAIL=
# CASHFREE_ENV=sandbox|production (default: production only when NODE_ENV=production); CASHFREE_CHECKOUT_BASE overrides the hosted-checkout URL prefix
# Webhook URLs to register: {API_PUBLIC_URL}/webhooks/payments/razorpay and /webhooks/payments/cashfree
# T2 KYC provider: mock | hyperverge | signzy | idfy
KYC_PROVIDER=mock
KYC_API_KEY=
# IDfy only: KYC_ACCOUNT_ID (sent as `account-id`) and KYC_IDFY_CONFIG_ID (the Video KYC profile configuration). KYC_BASE_URL / KYC_WEBHOOK_SECRET as for the other vendors.
# KYC_ACCOUNT_ID=
# KYC_IDFY_CONFIG_ID=

# ---- trust_verif (ADR-002/003) ----
# Udyam (MSME) and MCA/CIN registry verification. mock (default, refused in production) | surepass. Unset in production = feature unavailable.
UDYAM_PROVIDER=mock
MCA_PROVIDER=mock
# Surepass bearer token for both; base URL and timeout optional (default https://kyc-api.surepass.io, 8000 ms).
REGISTRY_PROVIDER_KEY=
# REGISTRY_PROVIDER_BASE_URL=
# REGISTRY_PROVIDER_TIMEOUT_MS=8000
# 1 = a passing Udyam check grants Tier 1 to a seller with NO GSTIN (sub-threshold MSMEs). Default off: GST stays the T1 gate.
UDYAM_GRANTS_T1=0
# T3 partner audit checklist override (JSON array of {id,label,required}); default checklist in packages/identity/src/audit-partners.ts.
# AUDIT_CHECKLIST_JSON=
# Public origin of the partner upload page (the admin app); links look like {origin}/partner/audit/<token>. Default ADMIN_APP_URL.
# AUDIT_PARTNER_BASE_URL=
# Buyer reachability (ADR-002). IVR provider: off (default) | mock | exotel | knowlarity. With it off the WhatsApp/SMS confirm link is used.
REACHABILITY_IVR_PROVIDER=off
# REACHABILITY_IVR_KEY= / REACHABILITY_IVR_SECRET= (vendor credentials), REACHABILITY_IVR_SID= (Exotel account sid / Knowlarity agent number),
# REACHABILITY_IVR_CALLER_ID= (ExoPhone / DID), REACHABILITY_IVR_FLOW_ID= (Exotel call-flow app id)
# REACHABILITY_WEBHOOK_SECRET= 32+ chars: HMAC key for callbacks from vendors that sign (header x-reachability-signature)
# REACHABILITY_URL_SECRET= 32+ chars, DIFFERENT from the webhook secret: Exotel only; per-check URL tokens are HMAC(secret, checkId), the secret itself never appears in a URL
# REACHABILITY_CALLBACK_BASE_URL= public API origin (default API_URL); callbacks go to {origin}/webhooks/reachability
# Automatic check after an enquiry: off | low_intent (default: intent below REACHABILITY_PROACTIVE_INTENT_BELOW=60, or fake-lead risk >= 40) | all
REACHABILITY_PROACTIVE=low_intent
# Feature flags (ADR phase gates): sponsored placements default OFF pending legal review (ADR-024)
ADS_ENABLED=false
PROMOTIONS_ENABLED=true
REACHABILITY_CHECK_ENABLED=true
# Storefront video/map embed block (YouTube via youtube-nocookie, OpenStreetMap). OFF until its content is moderated (ADR-003; follow-up in
# docs/design/cookie-consent.md). Off: Studio hides the block, saving/publishing one is rejected, a stored one renders nothing, and the
# buyer-web consent notice stays at policy v3. Needs a web REBUILD to change (the consent notice is inlined); turning it on moves the notice to v4.
STOREFRONT_EMBEDS_ENABLED=false

# ---- Phase 2 (ADR-012..017): all OFF by default; each module is built and tested, enable per environment ----
# Escrow via RBI-authorised PA partner (ADR-012). Partner: mock | razorpay_route | cashfree. Seller pays the fee (+GST) at release.
ESCROW_ENABLED=false
ESCROW_PARTNER=mock
# No default: an unset secret means no webhook verifies (also for the mock partner). Set it in dev too.
ESCROW_WEBHOOK_SECRET=
# ESCROW_MOCK_CHECKOUT=1   # explicit opt-in to the mock partner in a production build (e2e only)
ESCROW_FEE_BPS=150
ESCROW_FEE_CAP_PAISE=500000
ESCROW_AUTO_RELEASE_DAYS=7
ESCROW_FUNDING_TTL_HOURS=72
ESCROW_MIN_PAISE=10000
# Webhook URL to register with the partner: {API_PUBLIC_URL}/webhooks/escrow/<partner>
# AI-mediated disputes (ADR-013); auto-resolution only for small, high-confidence cases of these types
DISPUTES_ENABLED=false
DISPUTES_AUTO_MAX_PAISE=500000
DISPUTES_AUTO_MIN_CONFIDENCE=0.85
DISPUTES_AUTO_TYPES=quantity_short,damaged,wrong_item
DISPUTES_RESPONSE_HOURS=72
DISPUTES_ESCALATION_HOURS=48
# Seller quote-assist + buyer comparison/counter assist (ADR-014)
QUOTE_ASSIST_ENABLED=false
# CV pre-dispatch quality checks (ADR-015): pilot categories (comma-separated slugs) and the accuracy gate
QUALITY_CHECKS_ENABLED=false
QUALITY_CHECK_CATEGORIES=
QUALITY_MIN_LABELS=50
QUALITY_MIN_ACCURACY=0.9
# ONDC seller-network-participant adapter (ADR-017); keys are ed25519 (signing) / x25519 (encryption), base64
ONDC_ENABLED=false
ONDC_ENV=staging
ONDC_SUBSCRIBER_ID=
ONDC_UNIQUE_KEY_ID=
ONDC_SUBSCRIBER_URL=
ONDC_SIGNING_PRIVATE_KEY=
ONDC_ENCRYPTION_PRIVATE_KEY=
ONDC_ENCRYPTION_PUBLIC_KEY=
ONDC_REGISTRY_ENCRYPTION_PUBLIC_KEY=
ONDC_DOMAINS=ONDC:RET10
ONDC_CITY_CODES=*
ONDC_CATEGORY_MAP={}

# ---- Phase 3 (ADR-019..022): all OFF by default ----
# Embedded credit via NBFC partner (ADR-019). Needs the person's credit_underwriting consent; the NBFC is lender of record.
CREDIT_ENABLED=false
CREDIT_PARTNER=mock
# No default: an unset secret means no webhook verifies (also for the mock partner). Set it in dev too.
CREDIT_WEBHOOK_SECRET=
# CREDIT_MOCK_CHECKOUT=1   # explicit opt-in to the mock partner in a production build (e2e only)
CREDIT_LENDER_NAME=
CREDIT_GRIEVANCE_NAME=
CREDIT_GRIEVANCE_EMAIL=
CREDIT_GRIEVANCE_PHONE=
# Webhook URL for the partner: {API_PUBLIC_URL}/webhooks/credit/<partner> (header x-credit-signature, HMAC-SHA256 hex)
# Agent-to-agent commerce (ADR-020); auto-accept is per-mandate opt-in, never on by default
A2A_ENABLED=false
# Price intelligence (ADR-022): k-anonymity threshold (distinct sellers AND buyers per published cell)
PRICE_INTEL_ENABLED=false
PRICE_K=5
# ONDC live (ADR-021): gateway header required in prod; IGM TTLs (ISO 8601 durations); grievance officer contact
ONDC_REQUIRE_GATEWAY_AUTH=
ONDC_IGM_RESPONSE_TTL=PT1H
ONDC_IGM_RESOLUTION_TTL=PT24H
ONDC_GRO_NAME=
ONDC_GRO_EMAIL=
ONDC_GRO_PHONE=

# Client IP for rate limits/audit (@cnote/security clientIp): cf-connecting-ip first, ONLY when TRUST_CLOUDFLARE=1 (Cloudflare
# overwrites it; the origin must only accept Cloudflare traffic; production deploys behind Cloudflare set it), then the X-Forwarded-For entry added by our own proxies counted from the right.
# Number of proxies we run in front of the apps (load balancer + ingress = 2). Never trust the first XFF entry.
TRUSTED_PROXY_HOPS=1
TRUST_CLOUDFLARE=

# ---- Production startup validation (packages/security/src/secrets.ts; NODE_ENV=production REFUSES TO START on any of these) ----
# - DATABASE_URL / LIVE_DATABASE_URL need TLS: ?sslmode=require (or verify-full) unless the host is localhost. DB_TLS_OPTIONAL=1 waives it
#   for a private network (document why). No localhost fallback for DATABASE_URL / LIVE_DATABASE_URL exists in production.
# - REDIS_URL must be rediss:// unless localhost. REDIS_TLS_OPTIONAL=1 waives it for a private network (document why).
# - OTP_DEV_ECHO=true is rejected (it returns one-time codes in API responses). e2e/dev-cluster ONLY: ALLOW_OTP_ECHO_IN_PRODUCTION=1.
# - A webhook secret is required for each ENABLED provider: RAZORPAY_WEBHOOK_SECRET (PAYMENTS_PROVIDER=razorpay), CASHFREE_WEBHOOK_SECRET
#   (=cashfree), ESCROW_WEBHOOK_SECRET (ESCROW_ENABLED), CREDIT_WEBHOOK_SECRET (CREDIT_ENABLED), KYC_WEBHOOK_SECRET (KYC_PROVIDER != mock),
#   WHATSAPP_APP_SECRET + WHATSAPP_VERIFY_TOKEN (WhatsApp Cloud enabled).
# - REVALIDATE_SECRET, when set, must be 32+ characters. DOMAIN_CHECK_SECRET is required when custom domains are enabled
#   (EDGE_PROVIDER=cloudflare|vercel|aws or DOMAINS_HTTP_PROBE=true).
# - CSP_REPORT_ONLY=1 needs CSP_REPORT_ONLY_ACK=1 (an unenforced CSP is a decision, not a default).
# DB_TLS_OPTIONAL=
# REDIS_TLS_OPTIONAL=
# CSP_REPORT_ONLY_ACK=
# DPDP export (/account/export): total size budget in bytes (default 26214400 = 25 MiB); rows per collection are capped per module.
# EXPORT_MAX_BYTES=

# --- search-vernacular-image-voice (docs/design/search-vernacular-image-voice.md) ---
# SEARCH_SYNONYMS=off ignores the staff-curated synonym dictionary (admin: Search tuning). Default on. SEARCH_TRANSLIT=off still governs the built-in lexicon.
# SEARCH_SYNONYMS=

# --- polish: DPDP inactivity erasure (docs/compliance/retention-schedule.md) ---
# Erase buyer-side personal accounts inactive for the window, after a notice of at least 48 hours (DPDP Rules 2025 r.8 / Third Schedule).
# Default OFF: confirm with counsel that the Third Schedule applies to the platform first.
# INACTIVITY_ERASURE_ENABLED=false
# Hours between the notice and the earliest erasure (default 168 = 7 days; values below 48 are raised to 48).
# INACTIVITY_NOTICE_HOURS=168
# Inactivity window in days (default 1095 = 3 years) and retention of decided nominee requests (default 1095).
# RETENTION_INACTIVE_ACCOUNTS_DAYS=1095
# RETENTION_NOMINEE_REQUESTS_DAYS=1095

# --- polish: CSP (docs/security/security-architecture.md) ---
# Subresource Integrity on the buyer web's external scripts (default on). Set off if a CDN rewrites JS bodies.
# NEXT_SRI=off

# ---- ai_ops: RFQ / quote attachment malware scanning (packages/media/src/scan.ts; docs/design/attachment-scanning.md) ----
# Every RFQ drawing and quote attachment is scanned BEFORE it becomes visible; a detection is quarantined and the uploader notified.
# A scanner that cannot answer fails closed (the upload is rejected). Production (web, seller) REFUSES TO START with uploads on and
# no scanner: set ATTACHMENT_SCANNER=clamav + CLAMAV_HOST, turn uploads off (RFQ_ATTACHMENTS_ENABLED=false), or acknowledge with ATTACHMENT_SCAN_WAIVER=1.
# mock (default) only detects the EICAR test string: for dev, CI and e2e.
ATTACHMENT_SCANNER=mock
# CLAMAV_HOST=clamav.internal
# CLAMAV_PORT=3310
# CLAMAV_TIMEOUT_MS=15000
# CLAMAV_CONNECT_TIMEOUT_MS=3000
# RFQ_ATTACHMENTS_ENABLED=true
# ATTACHMENT_SCAN_WAIVER=
# Retention (docs/compliance/retention-schedule.md): RFQ/quote attachments, days after the quote deadline; quarantined bytes, days after detection.
# RETENTION_ENQUIRY_ATTACHMENTS_DAYS=365
# RETENTION_ATTACHMENT_QUARANTINE_DAYS=30

# ---- ai_ops: storefront embed moderation (docs/design/storefront-embed-moderation.md) ----
# Days between re-checks of an approved YouTube/Vimeo embed (title/description can change after approval). STOREFRONT_EMBEDS_ENABLED stays off.
# STOREFRONT_EMBED_RECHECK_DAYS=7

# ---- ai_ops: refund confirmation polling (billing.refund-poll job) ----
# A refund the gateway accepted but never confirmed by webhook is polled after this many minutes (exponential backoff, max 8 polls, then an alert).
# REFUND_POLL_AFTER_MINUTES=30
# Mock gateway only: PAYMENTS_MOCK_REFUND_PENDING=1 leaves refunds unconfirmed; PAYMENTS_MOCK_REFUND_STATUS=pending|failed|processed sets the poll answer.
# --- Freight estimator (@cnote/logistics; docs/design/freight-estimator.md). Estimate only: the platform never books or owns logistics. ---
# FREIGHT_ESTIMATOR_ENABLED=true   # false hides the PDP panel, the quote "Suggest freight" button, landed cost and the API endpoint
# FREIGHT_PROVIDER=heuristic       # heuristic (DB rate card, default, deterministic) | shiprocket | delhivery. Live providers price courier
#                                  # parcels only; part-truck / full-truck lanes and any failure fall back to the rate card.
# Production refuses to start with a live provider and missing credentials (validateSecrets):
# SHIPROCKET_EMAIL=                # Shiprocket API user (Settings > API); token is fetched via POST /auth/login and cached 8 days
# SHIPROCKET_PASSWORD=
# SHIPROCKET_BASE_URL=https://apiv2.shiprocket.in/v1/external
# DELHIVERY_API_TOKEN=             # Delhivery API token (sent as "Authorization: Token <token>")
# DELHIVERY_CLIENT_NAME=           # optional `cl` parameter on the invoice-charges call
# DELHIVERY_BASE_URL=https://track.delhivery.com

# --- buyer approvals + team (docs/design/buyer-approvals.md): no feature flag, rules are per business and empty by default ---
# Hours an approver has before a reminder (and between reminders). Default 24.
# APPROVAL_SLA_HOURS=24
# Reminders sent per level before the request waits for expiry. Default 3.
# APPROVAL_MAX_REMINDERS=3
# Days after which an undecided request expires (the held RFQ closes, the requester is told). Default 7.
# APPROVAL_EXPIRY_DAYS=7
# Retention windows (days): resolved approval records (default 2920 = 8 years), ended delegations (365), used/expired team invites (30).
# RETENTION_APPROVAL_RECORDS_DAYS=2920
# RETENTION_APPROVAL_DELEGATIONS_DAYS=365
# RETENTION_TEAM_INVITES_DAYS=30
# --- purchase orders, supplier invoices, MSME 43B(h) payment dues (docs/design/purchase-orders.md) ---
# PURCHASE_ORDERS_ENABLED: default on. Set to false/0/off to hide the PO screens and stop the reminder job (data stays).
# PURCHASE_ORDERS_ENABLED=true
# GST rate (basis points) of the line derived from an order when the buyer does not choose one (default 1800 = 18%).
# PO_DEFAULT_GST_RATE_BPS=1800
# Days after which closed purchase orders / settled supplier invoices lose delivery contacts and stored document files (default 2555 = 7 years).
# RETENTION_PO_DOCUMENTS_DAYS=2555
