DATABASE_URL=postgres://cnote:cnote@localhost:5432/cnote
REDIS_URL=redis://localhost:6379
# AI provider for reasoning capabilities: "heuristic" (offline, default) or "anthropic"
AI_PROVIDER=heuristic
ANTHROPIC_API_KEY=
# In dev, OTPs are logged to the server console instead of sent by SMS/WhatsApp
OTP_DEV_ECHO=true
# Auth (packages/identity). JWT_SECRET: 32+ random bytes, e.g. `openssl rand -base64 48`
JWT_SECRET=dev-only-insecure-jwt-secret-change-me-please-0123456789
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APP_URL=http://localhost:3000
# Admin access is granted via `pnpm admin:grant <email> <role...>` (packages/admin), not env.
ADMIN_APP_URL=http://localhost:3001
SELLER_APP_URL=http://localhost:3002

# Local object storage (dev) for @cnote/media
MEDIA_DRIVER=local
MEDIA_DIR=.data/media

# Sentry (all apps + worker). Leave empty to disable. Browser DSN must be NEXT_PUBLIC_*.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=
# Build-time source-map upload (CI/deploy only)
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT_WEB=
SENTRY_PROJECT_SELLER=
SENTRY_PROJECT_ADMIN=

# Microsoft Clarity (buyer web only; loads only after analytics consent). Leave empty to disable.
NEXT_PUBLIC_CLARITY_PROJECT_ID=

# Public REST API + MCP (apps/api)
API_PUBLIC_URL=http://localhost:3003
API_CORS_ORIGINS=http://localhost:3000,http://localhost:3002
API_RATE_LIMIT_PER_MIN=120

# Cache purge: shared secret between the cache worker and POST /api/revalidate on the web app (leave empty to disable in dev)
REVALIDATE_SECRET=

# Live read database (CQRS): buyers read published projections only. Can be a separate cluster.
LIVE_DATABASE_URL=postgres://cnote:cnote@localhost:5432/cnote_live

# Search backend: postgres (default) | opensearch — see docs/design/search-index.md
SEARCH_BACKEND=postgres
OPENSEARCH_URL=
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=

# Object storage (@cnote/media): local | r2 | s3 | azure | gcs. Cloudflare R2 example:
#   MEDIA_DRIVER=r2  MEDIA_ENDPOINT=https://<account>.r2.cloudflarestorage.com  MEDIA_REGION=auto
MEDIA_BUCKET=
MEDIA_PRIVATE_BUCKET=
MEDIA_ENDPOINT=
MEDIA_REGION=
MEDIA_ACCESS_KEY_ID=
MEDIA_SECRET_ACCESS_KEY=
MEDIA_PUBLIC_BASE_URL=

# Storefront hosting + custom domains (@cnote/domains) — see docs/design/custom-domains.md
STOREFRONT_ROOT_DOMAIN=localhost
STOREFRONT_CNAME_TARGET=stores.example.com
STOREFRONT_APEX_IPS=
PLATFORM_HOSTS=localhost,127.0.0.1
EDGE_PROVIDER=mock
CF_API_TOKEN=
CF_ZONE_ID=
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
DOMAINS_DNS_RESOLVERS=1.1.1.1,8.8.8.8
DOMAINS_HTTP_PROBE=false
DOMAIN_CHECK_SECRET=
STUDIO_APP_URL=http://localhost:3004

# GST verification provider (@cnote/identity gst): mock | cashfree | surepass
GST_PROVIDER=mock
GST_PROVIDER_KEY=
GST_PROVIDER_SECRET=
GST_PROVIDER_BASE_URL=

# Signed preview links for unpublished listing versions (falls back to JWT_SECRET)
PREVIEW_TOKEN_SECRET=

# Security (packages/security; see docs/security/security-architecture.md)
# CSP_REPORT_ONLY=1                       # observe violations without enforcing (roll out first)
# CSP_STRICT_STYLES=0
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=         # Cloudflare Turnstile (web + seller sign-up, OTP). Unset = widget hidden, dev verifier passes
# TURNSTILE_SECRET=
# HUMAN_VERIFIER=turnstile                # turnstile | hcaptcha | recaptcha | off
# FIELD_ENCRYPTION_KEYS=                  # kid1:base64key[,kid2:base64key]  (openssl rand -base64 32); first is active
# FIELD_ENCRYPTION_ACTIVE_KID=
# BLIND_INDEX_KEY=                        # openssl rand -base64 32
# MFA_ISSUER=Cnote
# MFA_ADMIN_OPTIONAL=0                    # dev only: let admins sign in without MFA (ignored in production)

# App origins (storefront Studio + cross-app links)
SELLER_APP_URL=http://localhost:3002
NEXT_PUBLIC_SELLER_APP_URL=http://localhost:3002
NEXT_PUBLIC_STUDIO_APP_URL=http://localhost:3004

# Postgres pool size per process (default 10; builds use 2)
DATABASE_POOL_MAX=10
