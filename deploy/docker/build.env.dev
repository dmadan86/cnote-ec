# LOCAL-DEV PLACEHOLDERS ONLY (not secrets): consumed as the `build_env` build secret by docker-compose.apps.yml so `next build` can reach
# the Postgres/Redis that `docker compose up -d postgres redis` publishes on the host's loopback (Docker Desktop maps host.docker.internal).
# On Linux add `extra_hosts: host.docker.internal:host-gateway` or build with `--network host`. NEVER put real credentials in this file.
DATABASE_URL=postgres://cnote:cnote@host.docker.internal:5432/cnote
LIVE_DATABASE_URL=postgres://cnote:cnote@host.docker.internal:5432/cnote_live
REDIS_URL=redis://:cnote-dev-redis@host.docker.internal:6379
