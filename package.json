{
  "name": "cnote",
  "private": true,
  "packageManager": "pnpm@10.27.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @cnote/web dev",
    "worker": "pnpm --filter @cnote/worker dev",
    "build": "pnpm -r --if-present build",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "db:generate": "pnpm --filter @cnote/db generate",
    "db:migrate": "pnpm --filter @cnote/db migrate:deploy",
    "db:deploy": "pnpm --filter @cnote/db migrate:deploy",
    "db:seed": "pnpm --filter @cnote/db seed",
    "db:reset": "pnpm --filter @cnote/db reset",
    "db:new": "pnpm --filter @cnote/db migrate:new",
    "db:check": "pnpm --filter @cnote/db migrate:check"
  },
  "devDependencies": {
    "@types/node": "^22",
    "dotenv": "^17.4.2",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.0"
  }
}
