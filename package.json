{
  "name": "cnote",
  "private": true,
  "packageManager": "pnpm@10.27.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @cnote/web dev",
    "worker": "pnpm --filter @cnote/worker dev",
    "build": "pnpm -r --if-present build",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "db:generate": "pnpm --filter @cnote/db generate",
    "db:migrate": "pnpm --filter @cnote/db migrate:deploy",
    "db:deploy": "pnpm --filter @cnote/db migrate:deploy",
    "db:seed": "pnpm --filter @cnote/worker seed",
    "db:reset": "pnpm --filter @cnote/db reset",
    "db:new": "pnpm --filter @cnote/db migrate:new",
    "db:check": "pnpm --filter @cnote/db migrate:check",
    "dev:seller": "pnpm --filter @cnote/seller-app dev",
    "dev:admin": "pnpm --filter @cnote/admin-app dev",
    "admin:grant": "pnpm --filter @cnote/admin grant",
    "check:boundaries": "tsx scripts/check-boundaries.ts",
    "test:boundaries": "vitest run scripts/check-boundaries.test.ts",
    "test:coverage": "bash scripts/test-coverage.sh",
    "dev:studio": "pnpm --filter @cnote/studio-app dev",
    "db:test:prepare": "bash scripts/db-test-prepare.sh"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22",
    "@vitest/coverage-v8": "^4.1.11",
    "dotenv": "^17.4.2",
    "fast-check": "^4.10.2",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.0"
  }
}
