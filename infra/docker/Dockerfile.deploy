# syntax=docker/dockerfile:1.7
# Slim runtime image for any Node service (api, worker, ai-service, search-service) using `pnpm deploy`: only the target
# app's production dependency closure ends up in the image (no other apps, no dev tooling), non-root, PID 1 = node.
#
#   docker build -f infra/docker/Dockerfile.deploy \
#     --build-arg PKG=@cnote/ai-service --build-arg APP_DIR=ai-service --build-arg PORT=3005 -t cnote-ai-service:slim .
#
# STATUS: authored without a Docker daemon available; the CI-verified images remain apps/<app>/Dockerfile (same recipe as
# apps/api). Validate this variant once (docker build + /ready) before switching a service to it. Known trap: internal
# packages export TypeScript source and @cnote/db's generated Prisma client is gitignored, so it is copied explicitly.
# The Next.js apps (web, seller, admin) keep their own multi-stage Dockerfiles (apps/{web,seller,admin}/Dockerfile: build
# stage + non-root runtime), because `next start` needs the built .next output.

# Pinned by digest (supply chain). Refresh: docker buildx imagetools inspect node:22-bookworm-slim, or let Dependabot (docker) do it.
ARG NODE_IMAGE=node:22-bookworm-slim@sha256:43ac6c60b8f89723f746e8a92ce91abd5017e627ce1ddfe4238355d3a30b772c
FROM ${NODE_IMAGE} AS base
ENV PNPM_HOME=/pnpm PNPM_STORE_DIR=/pnpm/store CI=true
ENV PATH=$PNPM_HOME:$PATH
RUN apt-get update \
 && apt-get install -y --no-install-recommends openssl ca-certificates \
 && rm -rf /var/lib/apt/lists/* \
 && corepack enable && corepack prepare pnpm@10.34.6 --activate
WORKDIR /repo

FROM base AS fetch
COPY pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm fetch

FROM fetch AS build
ARG PKG
ARG APP_DIR
COPY . .
RUN test -n "$PKG" && test -n "$APP_DIR"
RUN DATABASE_URL=postgres://build:build@localhost:5432/build \
    LIVE_DATABASE_URL=postgres://build:build@localhost:5432/build_live \
    pnpm install --offline --frozen-lockfile -w --filter "${PKG}..."
# Production closure of the app + its workspace packages, then the pieces `deploy` does not pack.
RUN pnpm --filter "${PKG}" deploy --legacy --prod /out \
 && mkdir -p /out/node_modules/@cnote/db/src \
 && cp -r packages/db/src/generated /out/node_modules/@cnote/db/src/generated \
 && (test -d packages/live-db/src/generated && mkdir -p /out/node_modules/@cnote/live-db/src && cp -r packages/live-db/src/generated /out/node_modules/@cnote/live-db/src/generated || true) \
 && cp -r /repo/node_modules/tsx /out/node_modules/tsx 2>/dev/null || true
RUN cd /out && pnpm add --offline tsx@^4.20.0 --ignore-workspace 2>/dev/null || true

FROM ${NODE_IMAGE} AS runtime
ARG PORT=3000
ENV NODE_ENV=production PORT=${PORT}
RUN apt-get update && apt-get install -y --no-install-recommends openssl ca-certificates && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=build --chown=node:node /out /app
USER node
EXPOSE ${PORT}
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:'+process.env.PORT+'/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node", "--import", "tsx", "src/server.ts"]
