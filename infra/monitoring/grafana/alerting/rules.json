        {
          "uid": "cnote-alert-lead-to-conversation-rate",
          "title": "Metric alert open: lead_to_conversation_rate",
          "condition": "C",
          "for": "5m",
          "noDataState": "OK",
          "execErrState": "Error",
          "labels": {
            "severity": "warning",
            "route": "product-ops"
          },
          "annotations": {
            "summary": "@cnote/metrics raised an open alert for lead_to_conversation_rate (value vs threshold in admin > Metrics).",
            "runbook_url": "https://github.com/CHANGE-ME/cnote/blob/main/docs/ops/monitoring.md#runbook-trust-metrics"
          },
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": {
                "from": 600,
                "to": 0
              },
              "datasourceUid": "cnote-pg",
              "model": {
                "refId": "A",
                "datasource": {
                  "type": "grafana-postgresql-datasource",
                  "uid": "cnote-pg"
                },
                "format": "table",
                "rawQuery": true,
                "editorMode": "code",
                "rawSql": "SELECT count(*)::float AS open FROM metric_alerts WHERE metric='lead_to_conversation_rate' AND resolved_at IS NULL",
                "intervalMs": 1000,
                "maxDataPoints": 43200
              }
            },
            {
              "refId": "B",
              "datasourceUid": "__expr__",
              "model": {
                "refId": "B",
                "type": "reduce",
                "expression": "A",
                "reducer": "last",
                "settings": {
                  "mode": "dropNN"
                }
              }
            },
            {
              "refId": "C",
              "datasourceUid": "__expr__",
              "model": {
                "refId": "C",
                "type": "threshold",
                "expression": "B",
                "conditions": [
                  {
                    "evaluator": {
                      "type": "gt",
                      "params": [
                        0
                      ]
                    }
                  }
                ]
              }
            }
          ]
        },
