    {
      "id": 30,
      "type": "stat",
      "title": "Seconds since metrics job last wrote",
      "description": "metrics.refresh-recent runs every 15 minutes.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "cnote-pg"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "cnote-pg"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT EXTRACT(EPOCH FROM (now()-max(computed_at))) AS seconds_since_metrics_job FROM metric_daily"
        }
      ],
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 5
      },
