                "value": 3600
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 31,
      "type": "timeseries",
      "title": "Domain events per hour",
      "description": "A flat line during business hours means the app tier stopped emitting.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "cnote-pg"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "cnote-pg"
          },
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT date_trunc('hour', occurred_at) AS time, count(*) AS events FROM domain_events WHERE $__timeFilter(occurred_at) GROUP BY 1 ORDER BY 1"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 32,
      "type": "timeseries",
      "title": "Outbox relay delay (avg seconds)",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "cnote-pg"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "cnote-pg"
          },
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT date_trunc('hour', occurred_at) AS time, avg(EXTRACT(EPOCH FROM (published_at-occurred_at))) AS relay_delay_seconds FROM domain_events WHERE published_at IS NOT NULL AND $__timeFilter(occurred_at) GROUP BY 1 ORDER BY 1"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {}
    },
