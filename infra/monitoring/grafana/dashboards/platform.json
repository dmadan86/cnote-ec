  "panels": [
    {
      "id": 28,
      "type": "stat",
      "title": "Outbox backlog (unpublished events)",
      "description": "Rows the relay has not yet published. Sustained growth = worker down or Redis unreachable.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "cnote-pg"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "cnote-pg"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT count(*) AS unpublished, COALESCE(EXTRACT(EPOCH FROM (now()-min(occurred_at))),0) AS oldest_seconds FROM domain_events WHERE published_at IS NULL"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1000
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 29,
      "type": "gauge",
      "title": "Outbox lag (oldest unpublished, seconds)",
